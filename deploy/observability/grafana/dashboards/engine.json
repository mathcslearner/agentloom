    {
      "type": "timeseries",
      "title": "Queue depths",
      "description": "Ready = undelivered entries (growth means dispatch is outrunning consumption). PEL = in-flight leases (growth means stuck or slow handlers). Delayed = scheduled retries. Stream = total including acked-but-untrimmed. Each worker samples the same fleet-wide values, so max() dedups replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(engine_queue_ready_depth)",
          "legendFormat": "ready"
        },
        {
          "refId": "B",
          "expr": "max(engine_queue_pel_size)",
          "legendFormat": "PEL (in-flight)"
        },
        {
          "refId": "C",
          "expr": "max(engine_queue_delayed_depth)",
          "legendFormat": "delayed (retries)"
        },
        {
          "refId": "D",
          "expr": "max(engine_queue_stream_length)",
          "legendFormat": "stream length"
        }
      ]
    },
