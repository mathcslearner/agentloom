    {
      "type": "timeseries",
      "title": "Step completions/s by outcome",
      "description": "Executor invocations finishing per second, split by outcome (succeeded, transient, timeout, permanent, cancelled). The engine's core throughput signal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(engine_step_duration_seconds_count[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
