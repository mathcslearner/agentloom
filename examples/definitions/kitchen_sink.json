{
  "schema_version": 1,
  "name": "kitchen-sink",
  "description": "A research-and-publish pipeline that exercises every construct of the definition format: all 15 step types (noop, planner, retrieve, tool, map, join, llm, agent, branch, echo, sleep, fail_n_times, counter, effectful_echo, human_approval), unconditioned parallel fan-out, `when`-conditioned edges with has() guards, a branch with conditioned arms plus a trailing default, both join modes (any and all), a marked loop edge, all five param types, explicit retry policies (a full block and a partial one inheriting engine defaults, ADR-006), a per-step execution timeout (ticket 5.3), a run wall-clock deadline (ticket 5.6), the continue_independent_branches failure policy, a journaled side effect (ticket 5.5), and an engine-opaque ui block that round-trips byte-for-byte.",
  "on_failure": "continue_independent_branches",
  "max_wall_clock": "2h",
  "params": {
    "goal": {
      "type": "string",
      "required": true
    },
    "max_sources": {
      "type": "number"
    },
    "flags": {
      "type": "object"
    },
    "tags": {
      "type": "array"
    },
    "dry_run": {
      "type": "boolean"
    }
  },
  "steps": [
    {
      "id": "start",
      "type": "noop"
    },
    {
      "id": "plan",
      "type": "planner",
      "config": {
        "model": "anthropic/claude-sonnet-5",
        "prompt": "Break this goal into concrete research and writing steps: ${{ run.params.goal }}",
        "max_tokens": 1024
      }
    },
    {
      "id": "search",
      "type": "retrieve",
      "config": {
        "retriever": "pg_fulltext",
        "query": "${{ run.params.goal }}",
        "top_k": 8
      }
    },
    {
      "id": "fetch_sources",
      "type": "tool",
      "config": {
        "tool": "http_request",
        "input": {
          "method": "GET",
          "url": "https://sources.example.com/api/search?q=${{ run.params.goal }}&limit=${{ run.params.max_sources }}"
        }
      },
      "retry": {
        "max_attempts": 5
      },
      "timeout": "30s"
    },
    {
      "id": "flaky_probe",
      "type": "fail_n_times",
      "config": {
        "n": 2
      },
      "retry": {
        "max_attempts": 4,
        "backoff": {
          "initial": "250ms",
          "cap": "5s",
          "multiplier": 2
        },
        "jitter": "full",
        "retry_on": ["transient", "timeout"]
      }
    },
    {
      "id": "summarize_each",
      "type": "map",
      "config": {
        "items": "${{ steps.search.output.docs }}",
        "body": "summarize_source"
      }
    },
    {
      "id": "first_source",
      "type": "join",
      "config": {
        "mode": "any"
      }
    },
    {
      "id": "draft",
      "type": "llm",
      "config": {
        "model": "anthropic/claude-sonnet-5",
        "messages": [
          {
            "role": "user",
            "content": "Draft an article for ${{ run.params.goal }} from the plan and source material on the blackboard. Address any critique notes."
          }
        ],
        "max_tokens": 2048,
        "temperature": 0
      }
    },
    {
      "id": "critique",
      "type": "agent",
      "config": {
        "agent": "critic",
        "prompt": "Review the latest draft. Output JSON like {\"verdict\": \"approve\", \"channel\": \"blog\"} or {\"verdict\": \"revise\", \"notes\": [\"...\"]}."
      }
    },
    {
      "id": "route",
      "type": "branch",
      "config": {
        "input": {
          "channel": "${{ steps.critique.output.channel }}"
        }
      }
    },
    {
      "id": "blog_post",
      "type": "echo",
      "config": {
        "input": {
          "format": "markdown"
        }
      }
    },
    {
      "id": "newsletter",
      "type": "tool",
      "config": {
        "tool": "http_request",
        "input": {
          "method": "POST",
          "url": "https://mailer.example.com/api/campaigns",
          "body": {
            "subject": "${{ run.params.goal }}"
          }
        }
      }
    },
    {
      "id": "archive",
      "type": "noop"
    },
    {
      "id": "gather",
      "type": "join",
      "config": {
        "mode": "all"
      }
    },
    {
      "id": "approve",
      "type": "human_approval",
      "config": {
        "prompt": "Content is formatted and ready. OK to publish?"
      }
    },
    {
      "id": "cooldown",
      "type": "sleep",
      "config": {
        "duration": "1s"
      }
    },
    {
      "id": "publish",
      "type": "echo",
      "config": {
        "input": {
          "status": "published"
        }
      }
    },
    {
      "id": "tally",
      "type": "counter",
      "config": {
        "path": "out/publish-count.log"
      }
    },
    {
      "id": "notify",
      "type": "effectful_echo",
      "config": {
        "path": "out/notify-count.log",
        "input": {
          "notified": true
        },
        "fail_times": 1
      },
      "retry": {
        "max_attempts": 3
      }
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "plan"
    },
    {
      "from": "start",
      "to": "search"
    },
    {
      "from": "start",
      "to": "flaky_probe"
    },
    {
      "from": "search",
      "to": "summarize_each",
      "when": "has(output.docs) && size(output.docs) > 0"
    },
    {
      "from": "search",
      "to": "fetch_sources"
    },
    {
      "from": "summarize_each",
      "to": "first_source"
    },
    {
      "from": "fetch_sources",
      "to": "first_source"
    },
    {
      "from": "flaky_probe",
      "to": "first_source"
    },
    {
      "from": "plan",
      "to": "draft"
    },
    {
      "from": "first_source",
      "to": "draft"
    },
    {
      "from": "draft",
      "to": "critique"
    },
    {
      "from": "critique",
      "to": "draft",
      "type": "loop",
      "condition": "output.verdict == 'revise'",
      "max_iterations": 3
    },
    {
      "from": "critique",
      "to": "route"
    },
    {
      "from": "route",
      "to": "blog_post",
      "when": "output.channel == 'blog'"
    },
    {
      "from": "route",
      "to": "newsletter",
      "when": "output.channel == 'newsletter'"
    },
    {
      "from": "route",
      "to": "archive"
    },
    {
      "from": "blog_post",
      "to": "gather"
    },
    {
      "from": "newsletter",
      "to": "gather"
    },
    {
      "from": "archive",
      "to": "gather"
    },
    {
      "from": "gather",
      "to": "approve",
      "when": "!has(run.params.dry_run) || run.params.dry_run != true"
    },
    {
      "from": "approve",
      "to": "cooldown"
    },
    {
      "from": "cooldown",
      "to": "publish"
    },
    {
      "from": "publish",
      "to": "tally"
    },
    {
      "from": "tally",
      "to": "notify"
    }
  ],
  "ui": {
    "nodes": {
      "start": {"position": {"x": 0, "y": 200}},
      "plan": {"position": {"x": 180, "y": 80}},
      "search": {"position": {"x": 180, "y": 320}},
      "draft": {"position": {"x": 560.5, "y": 200}},
      "critique": {"position": {"x": 740, "y": 200}}
    },
    "zoom": 0.8,
    "builder_metadata_the_engine_must_round_trip": ["anything", {"goes": "here"}]
  }
}
