{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Definition",
  "$defs": {
    "AgentConfig": {
      "properties": {
        "agent": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "BackoffSpec": {
      "properties": {
        "initial": {
          "type": "string"
        },
        "cap": {
          "type": "string"
        },
        "multiplier": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "BranchConfig": {
      "properties": {
        "input": true
      },
      "additionalProperties": false,
      "type": "object"
    },
    "BudgetPolicy": {
      "type": "string",
      "enum": [
        "park",
        "fail"
      ]
    },
    "CacheMode": {
      "type": "string",
      "enum": [
        "off",
        "read_write",
        "read_only"
      ]
    },
    "CachePolicy": {
      "properties": {
        "mode": {
          "$ref": "#/$defs/CacheMode"
        },
        "ttl": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/CacheScope"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CacheScope": {
      "type": "string",
      "enum": [
        "global",
        "run"
      ]
    },
    "CounterConfig": {
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Definition": {
      "properties": {
        "schema_version": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "on_failure": {
          "$ref": "#/$defs/FailurePolicy"
        },
        "max_wall_clock": {
          "type": "string"
        },
        "budget_usd": {
          "type": "number"
        },
        "on_budget_exceeded": {
          "$ref": "#/$defs/BudgetPolicy"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/ParamSpec"
          },
          "type": "object"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "type": "array"
        },
        "ui": {
          "type": "object",
          "description": "Engine-opaque builder state: never validated or interpreted, round-tripped byte-for-byte."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "name",
        "steps",
        "edges"
      ]
    },
    "EchoConfig": {
      "properties": {
        "input": true
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Edge": {
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "when": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EdgeType"
        },
        "condition": {
          "type": "string"
        },
        "max_iterations": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "from",
        "to"
      ]
    },
    "EdgeType": {
      "type": "string",
      "enum": [
        "normal",
        "loop"
      ]
    },
    "EffectfulEchoConfig": {
      "properties": {
        "path": {
          "type": "string"
        },
        "input": true,
        "fail_times": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ErrorClass": {
      "type": "string",
      "enum": [
        "transient",
        "permanent",
        "timeout",
        "cancelled",
        "validation_failed"
      ]
    },
    "FailNTimesConfig": {
      "properties": {
        "n": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "FailurePolicy": {
      "type": "string",
      "enum": [
        "fail_fast",
        "continue_independent_branches"
      ]
    },
    "FeedbackPolicy": {
      "properties": {
        "template": {
          "type": "string"
        },
        "max_output_chars": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "HumanApprovalConfig": {
      "properties": {
        "prompt": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "JitterMode": {
      "type": "string",
      "enum": [
        "full",
        "none"
      ]
    },
    "JoinConfig": {
      "properties": {
        "mode": {
          "$ref": "#/$defs/JoinMode"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "JoinMode": {
      "type": "string",
      "enum": [
        "all",
        "any"
      ]
    },
    "LLMConfig": {
      "properties": {
        "model": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/LLMMessage"
          },
          "type": "array"
        },
        "max_tokens": {
          "type": "integer"
        },
        "temperature": {
          "type": "number"
        },
        "model_fallbacks": {
          "items": {
            "$ref": "#/$defs/ModelFallback"
          },
          "type": "array"
        },
        "output_format": {
          "$ref": "#/$defs/OutputFormat"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "LLMMessage": {
      "properties": {
        "role": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "MapConfig": {
      "properties": {
        "items": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ModelFallback": {
      "properties": {
        "model": {
          "type": "string"
        },
        "at_budget_fraction": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "NoopConfig": {
      "properties": {},
      "additionalProperties": false,
      "type": "object"
    },
    "OutputFormat": {
      "properties": {
        "type": {
          "type": "string"
        },
        "schema": true,
        "mode": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ParamSpec": {
      "properties": {
        "type": {
          "$ref": "#/$defs/ParamType"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type"
      ]
    },
    "ParamType": {
      "type": "string",
      "enum": [
        "string",
        "number",
        "boolean",
        "object",
        "array"
      ]
    },
    "PlannerConfig": {
      "properties": {
        "model": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/LLMMessage"
          },
          "type": "array"
        },
        "max_tokens": {
          "type": "integer"
        },
        "temperature": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "RetrieveConfig": {
      "properties": {
        "retriever": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "top_k": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "RetryPolicy": {
      "properties": {
        "max_attempts": {
          "type": "integer"
        },
        "backoff": {
          "$ref": "#/$defs/BackoffSpec"
        },
        "jitter": {
          "$ref": "#/$defs/JitterMode"
        },
        "retry_on": {
          "items": {
            "$ref": "#/$defs/ErrorClass"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "SleepConfig": {
      "properties": {
        "duration": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Step": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "llm"
            },
            "config": {
              "$ref": "#/$defs/LLMConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "tool"
            },
            "config": {
              "$ref": "#/$defs/ToolConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "retrieve"
            },
            "config": {
              "$ref": "#/$defs/RetrieveConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "map"
            },
            "config": {
              "$ref": "#/$defs/MapConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "planner"
            },
            "config": {
              "$ref": "#/$defs/PlannerConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "agent"
            },
            "config": {
              "$ref": "#/$defs/AgentConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "human_approval"
            },
            "config": {
              "$ref": "#/$defs/HumanApprovalConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "join"
            },
            "config": {
              "$ref": "#/$defs/JoinConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "branch"
            },
            "config": {
              "$ref": "#/$defs/BranchConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "noop"
            },
            "config": {
              "$ref": "#/$defs/NoopConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "echo"
            },
            "config": {
              "$ref": "#/$defs/EchoConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "sleep"
            },
            "config": {
              "$ref": "#/$defs/SleepConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "fail_n_times"
            },
            "config": {
              "$ref": "#/$defs/FailNTimesConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "counter"
            },
            "config": {
              "$ref": "#/$defs/CounterConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "effectful_echo"
            },
            "config": {
              "$ref": "#/$defs/EffectfulEchoConfig"
            }
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/StepType"
        },
        "config": {
          "type": "object",
          "description": "Typed per step type; Step's oneOf variants bind each type to its config shape."
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy"
        },
        "timeout": {
          "type": "string"
        },
        "cache": {
          "$ref": "#/$defs/CachePolicy"
        },
        "budget": {
          "$ref": "#/$defs/StepBudget"
        },
        "validation": {
          "$ref": "#/$defs/ValidationPolicy"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "type"
      ]
    },
    "StepBudget": {
      "properties": {
        "max_usd": {
          "type": "number"
        },
        "max_tokens": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "StepType": {
      "type": "string",
      "enum": [
        "llm",
        "tool",
        "retrieve",
        "map",
        "planner",
        "agent",
        "human_approval",
        "join",
        "branch",
        "noop",
        "echo",
        "sleep",
        "fail_n_times",
        "counter",
        "effectful_echo"
      ]
    },
    "ToolConfig": {
      "properties": {
        "tool": {
          "type": "string"
        },
        "input": true
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ValidationPolicy": {
      "properties": {
        "validators": {
          "items": {
            "$ref": "#/$defs/ValidatorSpec"
          },
          "type": "array"
        },
        "max_attempts": {
          "type": "integer"
        },
        "feedback": {
          "$ref": "#/$defs/FeedbackPolicy"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ValidatorSpec": {
      "properties": {
        "name": {
          "type": "string"
        },
        "config": true,
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    }
  },
  "title": "agentloom workflow definition",
  "description": "Workflow definition format, schema_version 1 (ADR-003). Unknown fields are rejected everywhere except the engine-opaque ui block."
}
