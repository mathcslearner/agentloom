{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PlanOutput",
  "$defs": {
    "AgentConfig": {
      "properties": {
        "agent": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "BackoffSpec": {
      "properties": {
        "initial": {
          "type": "string"
        },
        "cap": {
          "type": "string"
        },
        "multiplier": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "BlackboardPolicy": {
      "properties": {
        "write": {
          "items": {
            "$ref": "#/$defs/BlackboardWrite"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "BlackboardWrite": {
      "properties": {
        "key": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pinned": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "key"
      ]
    },
    "BlackboardWriteConfig": {
      "properties": {
        "key": {
          "type": "string"
        },
        "value": true,
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expected_version": {
          "type": "integer"
        },
        "read_key": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "BranchConfig": {
      "properties": {
        "input": true
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CacheMode": {
      "type": "string",
      "enum": [
        "off",
        "read_write",
        "read_only"
      ]
    },
    "CachePolicy": {
      "properties": {
        "mode": {
          "$ref": "#/$defs/CacheMode"
        },
        "ttl": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/CacheScope"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CacheScope": {
      "type": "string",
      "enum": [
        "global",
        "run"
      ]
    },
    "CompactionStrategy": {
      "properties": {
        "strategy": {
          "type": "string"
        },
        "n": {
          "type": "integer"
        },
        "min_tokens": {
          "type": "integer"
        },
        "model": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "max_tokens": {
          "type": "integer"
        },
        "timeout": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "strategy"
      ]
    },
    "ContextMissingPolicy": {
      "type": "string",
      "enum": [
        "error",
        "skip"
      ]
    },
    "ContextSource": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/ContextSourceKind"
        },
        "name": {
          "type": "string"
        },
        "step": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "retriever": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "top_k": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        },
        "max_tokens": {
          "type": "integer"
        },
        "pinned": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer"
        },
        "on_missing": {
          "$ref": "#/$defs/ContextMissingPolicy"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "ContextSourceKind": {
      "type": "string",
      "enum": [
        "step_output",
        "blackboard",
        "retrieval",
        "literal"
      ]
    },
    "ContextSpec": {
      "properties": {
        "sources": {
          "items": {
            "$ref": "#/$defs/ContextSource"
          },
          "type": "array"
        },
        "budget_tokens": {
          "type": "integer"
        },
        "compaction": {
          "items": {
            "$ref": "#/$defs/CompactionStrategy"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CounterConfig": {
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "EchoConfig": {
      "properties": {
        "input": true
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Edge": {
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "when": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EdgeType"
        },
        "condition": {
          "type": "string"
        },
        "max_iterations": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "from",
        "to"
      ]
    },
    "EdgeType": {
      "type": "string",
      "enum": [
        "normal",
        "loop"
      ]
    },
    "EffectfulEchoConfig": {
      "properties": {
        "path": {
          "type": "string"
        },
        "input": true,
        "fail_times": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ErrorClass": {
      "type": "string",
      "enum": [
        "transient",
        "permanent",
        "timeout",
        "cancelled",
        "validation_failed"
      ]
    },
    "FailNTimesConfig": {
      "properties": {
        "n": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "FeedbackPolicy": {
      "properties": {
        "template": {
          "type": "string"
        },
        "max_output_chars": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "HumanApprovalConfig": {
      "properties": {
        "prompt": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "JitterMode": {
      "type": "string",
      "enum": [
        "full",
        "none"
      ]
    },
    "JoinConfig": {
      "properties": {
        "mode": {
          "$ref": "#/$defs/JoinMode"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "JoinMode": {
      "type": "string",
      "enum": [
        "all",
        "any"
      ]
    },
    "LLMConfig": {
      "properties": {
        "model": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/LLMMessage"
          },
          "type": "array"
        },
        "max_tokens": {
          "type": "integer"
        },
        "temperature": {
          "type": "number"
        },
        "model_fallbacks": {
          "items": {
            "$ref": "#/$defs/ModelFallback"
          },
          "type": "array"
        },
        "output_format": {
          "$ref": "#/$defs/OutputFormat"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "LLMMessage": {
      "properties": {
        "role": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "MapConfig": {
      "properties": {
        "items": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ModelFallback": {
      "properties": {
        "model": {
          "type": "string"
        },
        "at_budget_fraction": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "NoopConfig": {
      "properties": {},
      "additionalProperties": false,
      "type": "object"
    },
    "OutputFormat": {
      "properties": {
        "type": {
          "type": "string"
        },
        "schema": true,
        "mode": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "PlanOutput": {
      "properties": {
        "schema_version": {
          "type": "integer"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "steps"
      ]
    },
    "PlannerConfig": {
      "properties": {
        "model": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/LLMMessage"
          },
          "type": "array"
        },
        "max_tokens": {
          "type": "integer"
        },
        "temperature": {
          "type": "number"
        },
        "max_added_steps": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "RetrieveConfig": {
      "properties": {
        "retriever": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "top_k": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "RetryPolicy": {
      "properties": {
        "max_attempts": {
          "type": "integer"
        },
        "backoff": {
          "$ref": "#/$defs/BackoffSpec"
        },
        "jitter": {
          "$ref": "#/$defs/JitterMode"
        },
        "retry_on": {
          "items": {
            "$ref": "#/$defs/ErrorClass"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "SleepConfig": {
      "properties": {
        "duration": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Step": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "llm"
            },
            "config": {
              "$ref": "#/$defs/LLMConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "tool"
            },
            "config": {
              "$ref": "#/$defs/ToolConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "retrieve"
            },
            "config": {
              "$ref": "#/$defs/RetrieveConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "map"
            },
            "config": {
              "$ref": "#/$defs/MapConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "planner"
            },
            "config": {
              "$ref": "#/$defs/PlannerConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "agent"
            },
            "config": {
              "$ref": "#/$defs/AgentConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "human_approval"
            },
            "config": {
              "$ref": "#/$defs/HumanApprovalConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "join"
            },
            "config": {
              "$ref": "#/$defs/JoinConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "branch"
            },
            "config": {
              "$ref": "#/$defs/BranchConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "noop"
            },
            "config": {
              "$ref": "#/$defs/NoopConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "echo"
            },
            "config": {
              "$ref": "#/$defs/EchoConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "sleep"
            },
            "config": {
              "$ref": "#/$defs/SleepConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "fail_n_times"
            },
            "config": {
              "$ref": "#/$defs/FailNTimesConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "counter"
            },
            "config": {
              "$ref": "#/$defs/CounterConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "effectful_echo"
            },
            "config": {
              "$ref": "#/$defs/EffectfulEchoConfig"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "blackboard_write"
            },
            "config": {
              "$ref": "#/$defs/BlackboardWriteConfig"
            }
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/StepType"
        },
        "config": {
          "type": "object",
          "description": "Typed per step type; Step's oneOf variants bind each type to its config shape."
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy"
        },
        "timeout": {
          "type": "string"
        },
        "cache": {
          "$ref": "#/$defs/CachePolicy"
        },
        "budget": {
          "$ref": "#/$defs/StepBudget"
        },
        "validation": {
          "$ref": "#/$defs/ValidationPolicy"
        },
        "blackboard": {
          "$ref": "#/$defs/BlackboardPolicy"
        },
        "context": {
          "$ref": "#/$defs/ContextSpec"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "type"
      ]
    },
    "StepBudget": {
      "properties": {
        "max_usd": {
          "type": "number"
        },
        "max_tokens": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "StepType": {
      "type": "string",
      "enum": [
        "llm",
        "tool",
        "retrieve",
        "map",
        "planner",
        "agent",
        "human_approval",
        "join",
        "branch",
        "noop",
        "echo",
        "sleep",
        "fail_n_times",
        "counter",
        "effectful_echo",
        "blackboard_write"
      ]
    },
    "ToolConfig": {
      "properties": {
        "tool": {
          "type": "string"
        },
        "input": true
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ValidationPolicy": {
      "properties": {
        "validators": {
          "items": {
            "$ref": "#/$defs/ValidatorSpec"
          },
          "type": "array"
        },
        "max_attempts": {
          "type": "integer"
        },
        "feedback": {
          "$ref": "#/$defs/FeedbackPolicy"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ValidatorSpec": {
      "properties": {
        "name": {
          "type": "string"
        },
        "config": true,
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    }
  },
  "title": "agentloom planner PlanOutput",
  "description": "Planner expansion delta, schema_version 1 (ADR-015): new steps and edges spliced into the running graph. Unknown fields are rejected."
}
