# agentloom web app — server-side config (ticket 17.1).
#
# Copy to `.env.local` (git-ignored). These are read ONLY on the server: the
# proxy route handler and server components. They are never exposed to the
# browser — do NOT prefix any of these with NEXT_PUBLIC_.

# Backend origin. The compose stack binds 127.0.0.1:8080 by default.
AGENTLOOM_API_URL=http://127.0.0.1:8080

# Bearer API key (scopes: read + submit are enough for the builder/dashboard).
# Local dev options:
#   - use the compose root key you set as AGENTLOOM_API_ROOT_KEY, or
#   - mint one: `AGENTLOOM_API_KEY=<root> ctl keys create --scopes read,submit`
# It stays server-side; the browser talks to the same-origin /api/agentloom proxy.
AGENTLOOM_API_KEY=
