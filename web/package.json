{
  "name": "agentloom-web",
  "version": "0.0.0",
  "private": true,
  "description": "agentloom frontend workspace (M16.5 onward). The Next.js app arrives in M17.1; the engine-client library is the first package.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "pnpm --recursive --if-present run generate",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "build": "pnpm --recursive --if-present run build",
    "lint": "pnpm --recursive --if-present run lint",
    "build:verify": "pnpm --recursive --if-present run build:verify",
    "dev": "pnpm --filter @agentloom/app run dev",
    "e2e": "pnpm --filter @agentloom/app run e2e"
  }
}
