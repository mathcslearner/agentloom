{
  "name": "@agentloom/engine-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for the agentloom event feed: ticket auth, snapshot/backfill/tail, seq dedupe, resume, reconnection backoff (M16.5, ADR-018).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "tsx scripts/gen-events-types.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:run": "tsx examples/tail-run.ts",
    "example:firehose": "tsx examples/tail-firehose.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
